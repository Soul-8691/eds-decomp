*.gba
*.sym
*.sav
*.zip
roms/
assets/

# Build output and generated files. tools/agbcc is installed from ../agbcc (see Makefile).
build/
tools/agbcc/
__pycache__/
objdiff.json

# Local tooling and editor state.
.DS_Store
.claude/
**/.obsidian/workspace*
staging/

# Local multi-agent orchestration. These scripts drive the maintainer's own agent setup,
# depend on prompts in staging/ and pass local credentials, so they stay out of the public repo.
tools/opencode-agent
tools/advisor.py
tools/launch_*.sh
tools/watch_*.sh
tools/dashboard.py
tools/dashboard.html
docker/opencode/
cards/_log.txt

# mGBA script capture staging (ffmpeg reads *_frames/ locally; do not commit PNG sequences)
tools/testing_scenarios/recordings/**/*_frames/
tools/testing_scenarios/recordings/**/*.png

