#!/bin/sh
# Run a command from the repository root with the EDS toolchain.
#   tools/dr make -j8      |  tools/dr python3 tools/check.py <unit> ...
# Everything runs natively (WSL or Linux); there is no container. agbcc lives in tools/agbcc
# (installed from ../agbcc, see README.md). If tools/setup_native.sh has set up the optional
# extras (Python venv, permuter, m2c, objdiff-cli), its env file is sourced first.
REPO="$(cd "$(dirname "$0")/.." && pwd)"
ENV="${EDS_TOOLS:-$HOME/.eds-tools}/env.sh"
[ -f "$ENV" ] && . "$ENV"
cd "$REPO" && exec "$@"
