# Yu-Gi-Oh! The Eternal Duelist Soul (USA) - matching decompilation.
# Builds natively in WSL (or Linux) with agbcc and binutils-arm-none-eabi, like the pret decomps:
#     make setup            # once: check your ROM (baserom.gba in repo root or roms/) and extract into assets/
#     make -j$(nproc)       # build eds.gba
#     make -j$(nproc) compare   # build and check the SHA-1 against the original (now fails, see below)
# The ROM adds the cards listed in config/new_cards.txt (one name per line), so it no longer matches the
# original SHA-1; `make` still builds it. Their data comes from YGOPRODeck: the build downloads the cards it
# has not seen yet (needs network and Pillow then). `python3 tools/newcards.py capacity` says how many fit.
# agbcc is installed into tools/agbcc from a built copy of pret/agbcc next to this repository
# (../agbcc). The first build does that automatically, or run `make agbcc`; set AGBCC_SRC to use
# another checkout.

# `make release` (RELEASE=1) builds eds_release.gba, the mod as players get it (MOD_RELEASE in C, from
# build/include/mod_config.h): no deck-out protection, no starting trunk of 8 of every card, 40-card decks, at most 3
# copies of a card, and the formats unlocked by 10 wins each. Plain `make` builds eds.gba for testing: those eased
# and every format open. Switching between the two rebuilds the units that include the header (global.h does).
RELEASE  ?= 0
ifeq ($(RELEASE),1)
ROM      := eds_release.gba
else
ROM      := eds.gba
endif
ELF      := build/eds.elf
MAP      := build/eds.map
SYM      := $(ROM:.gba=.sym)
SHA1     := 510fbba212aca9bab95ea12f8fd933e62ee34dea

PREFIX   := arm-none-eabi-
AS       := $(PREFIX)as
LD       := $(PREFIX)ld
OBJCOPY  := $(PREFIX)objcopy
CPP      := cpp
AGBCC_SRC ?= ../agbcc
AGBCC_DIR ?= tools/agbcc
CC1      := $(AGBCC_DIR)/bin/agbcc
CC1_OLD  := $(AGBCC_DIR)/bin/old_agbcc
AGBLIB   := $(AGBCC_DIR)/lib
PYTHON   := python3

ASFLAGS  := -mcpu=arm7tdmi -mthumb-interwork -I .
CPPFLAGS := -nostdinc -undef -I include -I build/include -I $(AGBCC_DIR)/include -iquote .
# Game code: old_agbcc -O2. The Konami sound driver uses agbcc -O2 -fprologue-bugfix and
# AgbSram agbcc -O1; per-unit compiler+flags live in config/cflags.txt.
DEFAULT_CC1    := old_agbcc
DEFAULT_CFLAGS := -mthumb-interwork -Wimplicit -Wparentheses -O2 -fhex-asm
unit_cc   = $(AGBCC_DIR)/bin/$(or $(shell awk '$$1=="$(1)"{print $$2}' config/cflags.txt),$(DEFAULT_CC1))
unit_cflags = $(or $(shell awk '$$1=="$(1)"{$$1="";$$2="";print}' config/cflags.txt),$(DEFAULT_CFLAGS))

# Units in link order (see units.txt). A unit links the first of src/<u>.c, src/<u>.s,
# asm/<u>.s, data/<u>.s that exists.
# `make compare ASM_UNITS="bustup_scene ..."` forces those units back to asm (e.g. while
# someone is mid-edit on src/<unit>.c).
UNITS    := $(shell sed -e 's/\#.*//' -e '/^[[:space:]]*$$/d' -e '/^@/d' units.txt)
unit_obj  = $(if $(and $(wildcard src/$(1).c),$(if $(filter $(1),$(ASM_UNITS)),,y)),build/src/$(1).o,$(if $(wildcard src/$(1).s),build/srcasm/$(1).o,$(if $(wildcard asm/$(1).s),build/asm/$(1).o,build/data/$(1).o)))
OBJS     := $(foreach u,$(UNITS),$(call unit_obj,$(u)))

.PHONY: all release demo release-demo compare clean tidy objdiff-report setup agbcc card-icons syms FORCE
.SECONDARY:
.DELETE_ON_ERROR:

all: $(ROM)

release:
	$(MAKE) RELEASE=1 all

# Demo card pool: same as plain `make` (RELEASE=0, eds.gba rules) but repo-root new_cards.txt above ------ only.
demo:
	$(MAKE) RELEASE=0 NEWCARDS_PROFILE=demo ROM=eds_demo.gba all

# Release rules with the demo card pool only (not the same as `make demo`).
release-demo:
	$(MAKE) RELEASE=1 NEWCARDS_PROFILE=demo ROM=eds_release_demo.gba all

# MOD_RELEASE and MOD_DEMO for the C code, rewritten only when they change (so a switch rebuilds what includes it).
MOD_CONFIG := build/include/mod_config.h
$(MOD_CONFIG): FORCE
	@mkdir -p $(@D)
	@printf '/* Generated by the Makefile (MOD_RELEASE: make release; MOD_DEMO: make demo, make release-demo). Do not edit. */\n#define MOD_RELEASE $(RELEASE)\n#define MOD_DEMO $(if $(filter demo,$(NEWCARDS_PROFILE)),1,0)\n' > $@.tmp
	@if cmp -s $@.tmp $@; then rm $@.tmp; else mv $@.tmp $@; fi

compare: $(ROM)
	@echo "$(SHA1)  $(ROM)" | sha1sum -c - || { [ ! -e baserom.gba ] || $(PYTHON) tools/romdiff.py $(ROM) baserom.gba $(MAP); exit 1; }

# Check your ROM and extract the game's data into assets/ (never committed).
# Field card icons with a 17x17 miniature of each card's art, and their shared 64-colour palette
# (tools/cardicons.py; card_icons/*.png over build/assets): build/card_icons/. Needs a built tree.
card-icons: $(ROM)
	$(PYTHON) tools/cardicons.py build/card_icons

setup:
	$(PYTHON) tools/setup.py
	$(PYTHON) tools/newcards.py fetch

# agbcc, installed pokefirered-style: ../agbcc/install.sh copies the compilers, headers and
# libgcc/libc into tools/agbcc. Every C object waits for it (order-only).
CC1_INSTALLED := $(AGBCC_DIR)/bin/old_agbcc
agbcc: $(CC1_INSTALLED)
$(CC1_INSTALLED):
	@test -f $(AGBCC_SRC)/old_agbcc -a -f $(AGBCC_SRC)/agbcc -a -f $(AGBCC_SRC)/libgcc.a || { echo "error: no built agbcc in $(AGBCC_SRC). Clone https://github.com/pret/agbcc next to this repository and run ./build.sh there (or set AGBCC_SRC)."; exit 1; }
	cd $(AGBCC_SRC) && ./install.sh $(CURDIR)
	chmod +x $(AGBCC_DIR)/bin/*

clean:
	rm -rf build eds.gba eds_release.gba eds_demo.gba eds_release_demo.gba
	rm -f eds.sym eds_release.sym eds_demo.sym eds_release_demo.sym

syms: $(SYM)

$(ROM): $(ELF) $(SYM)
	$(OBJCOPY) -O binary -j .text -j .rodata -j .text.added -j .rodata.pinned -j .rodata.added -j .data --gap-fill 0 $< $@
	$(PYTHON) tools/fixptrs.py $< $@

# Regenerated on every run, because the object list depends on which src/ files exist and on ASM_UNITS.
build/ld_script.ld: units.txt tools/mkld.py $(OBJS) FORCE
	@mkdir -p $(@D)
	$(PYTHON) tools/mkld.py units.txt $@ $(OBJS)

FORCE:

build/autosyms.s: $(OBJS) symbols.ld tools/autosyms.py
	@mkdir -p $(@D)
	$(PYTHON) tools/autosyms.py $@ $(OBJS)

build/autosyms.o: build/autosyms.s
	$(AS) $(ASFLAGS) -o $@ $<

$(SYM): $(ELF)
	$(PYTHON) tools/mksym.py $< $@

$(ELF): build/ld_script.ld build/autosyms.o $(OBJS) | $(CC1_INSTALLED)
	$(LD) -T build/ld_script.ld -Map $(MAP) -o $@ $(OBJS) build/autosyms.o -L $(AGBLIB) -lgcc -lc
	$(PYTHON) tools/dumpsyms.py $@ build/symbols.txt   # config/symbols.txt keeps the original ROM's addresses

# The game's data (graphics, text, audio, tables) is never committed. `make setup` extracts it from your
# ROM into assets/, listed in config/assets.tsv; this step builds those files back into binary form.
ASSET_FILES  := $(shell find assets -path assets/new_cards -prune -o -type f -print 2>/dev/null)
ASSETS_BUILT := build/assets/.built
$(ASSETS_BUILT): config/assets.tsv config/functions.tsv tools/assets.py $(wildcard tools/assetfmt/*.py) $(ASSET_FILES)
	@test -d assets || { echo "error: assets/ not found. Put baserom.gba in the repo root or your ROM in roms/ and run 'make setup' (see README.md)."; exit 1; }
	$(PYTHON) tools/assets.py build

build/asm/crt0.o: $(ASSETS_BUILT)   # cartridge header

# Dependency files from an older build can name per-function asm files that a rename has since moved.
# A file that is really missing still fails when the assembler includes it.
asm/nonmatching/%.s: ;

# asm units: each includes its functions from asm/nonmatching/<unit>/
build/asm/%.o: asm/%.s asm/macros.inc
	@mkdir -p $(@D)
	$(AS) $(ASFLAGS) --MD build/asm/$*.d -o $@ $<

# Dependency files from an older build can name asset outputs that a manifest change has since renamed.
# They are all made by $(ASSETS_BUILT), so treat a missing one as up to date instead of failing.
build/assets/%.bin: ;

# The added cards: their data is fetched once into assets/new_cards/, then appended to the card tables.
# It also writes the card count (build/include/card_count.h/.inc) and the cards' constants in
# include/constants/cards.h, only when they change; the empty rule makes make look at them again afterwards.
# NEWCARDS_PROFILE=full (default) uses config/new_cards.txt; demo uses repo-root new_cards.txt above ------.
NEWCARDS_PROFILE ?= full
ifeq ($(NEWCARDS_PROFILE),demo)
CARD_LIST      := new_cards.txt
NEWCARDS_BUILT := build/assets/.newcards-demo
else
CARD_LIST      := config/new_cards.txt
NEWCARDS_BUILT := build/assets/.newcards-full
endif
NEWCARDS_GEN   := build/include/card_count.h build/include/card_count.inc include/constants/cards.h
$(NEWCARDS_BUILT): $(ASSETS_BUILT) $(CARD_LIST) tools/newcards.py $(wildcard assets/new_cards/art/*.png)
	NEW_CARDS_LIST=$(CARD_LIST) NEWCARDS_STAMP=$(NEWCARDS_BUILT) $(PYTHON) tools/newcards.py build
$(NEWCARDS_GEN): $(NEWCARDS_BUILT) ;

# The Deck Edit banlists (banlists/*_ban.json) that src/mod_banlists.c offers.
BANLISTS_GEN := build/include/banlists.h
$(BANLISTS_GEN): tools/banlist.py $(wildcard banlists/*_ban.json) $(wildcard card_pools/*.txt) $(NEWCARDS_BUILT)
	@mkdir -p $(@D)
	$(PYTHON) tools/banlist.py --all $@
build/src/mod_banlists.o: $(BANLISTS_GEN)
build/src/mod_banlist.o: $(BANLISTS_GEN)

# The testing opponent's deck (make only: the Duel Computer's slot on the deck opponents' page), from the .ydk in
# TEST_YDK; without that file there is no test opponent. Read every build, rewritten only when it changes.
TEST_YDK ?= /mnt/c/ProjectIgnis/deck/test.ydk
TESTDECK_GEN := build/include/test_deck.h
$(TESTDECK_GEN): tools/testdeck.py $(NEWCARDS_BUILT) FORCE
	@mkdir -p $(@D)
	@$(PYTHON) tools/testdeck.py "$(TEST_YDK)" $@
build/src/mod_decks.o build/src/mod_opponents.o: $(TESTDECK_GEN) $(NEWCARDS_GEN)

# The Synchro Monster frame: the Fusion frame recoloured white (tools/synchro_frame.py), for data/rodata_08087FD0.s.
SYNCHRO_FRAME := build/assets/synchro_frame.bin
$(SYNCHRO_FRAME): $(ASSETS_BUILT) tools/synchro_frame.py
	$(PYTHON) tools/synchro_frame.py $@
# The Xyz Monster frame: the same, recoloured black.
XYZ_FRAME := build/assets/xyz_frame.bin
$(XYZ_FRAME): $(ASSETS_BUILT) tools/synchro_frame.py
	$(PYTHON) tools/synchro_frame.py $@ xyz
build/data/rodata_08087FD0.o: $(SYNCHRO_FRAME) $(XYZ_FRAME)
# src/mod_synchro.c reads build/include/synchro_rules.h, which tools/newcards.py writes.
build/src/mod_synchro.o: $(NEWCARDS_BUILT)
# src/mod_xyz.c reads build/include/xyz_rules.h, which tools/newcards.py writes.
build/src/mod_xyz.o: $(NEWCARDS_BUILT)

# Password-machine card prices from the Yugi-Kaiba usage statistics (src/mod_dp.c).
PRICES_GEN := build/include/card_prices.h
$(PRICES_GEN): tools/cardprices.py tools/banlist.py $(wildcard usage/*.json) $(wildcard banlists/*_ban.json) $(NEWCARDS_BUILT)
	@mkdir -p $(@D)
	$(PYTHON) tools/cardprices.py $@
build/src/mod_dp.o: $(PRICES_GEN)

FORMAT_PACKS_GEN := build/include/format_pack_data.h
FORMAT_PACK_ROULETTES_BIN := build/assets/format_pack_roulettes.bin
$(FORMAT_PACKS_GEN): tools/format_packs.py tools/banlist.py packs/formats.json $(wildcard usage/*.json) $(NEWCARDS_BUILT)
	@mkdir -p $(@D)
	$(PYTHON) tools/format_packs.py $@
-include build/include/format_pack_data.d
# Written by the same run as the header (not by build/assets/%.bin's empty rule).
$(FORMAT_PACK_ROULETTES_BIN): $(FORMAT_PACKS_GEN) ;
build/src/mod_format_packs.o: $(FORMAT_PACKS_GEN)
build/data/mod_format_pack_roulettes.o: $(FORMAT_PACK_ROULETTES_BIN)

# The field card icons' palette, frames and art miniatures (tools/cardicons.py --data), for
# data/mod_field_icons_data.s.
FIELD_ICONS := build/assets/field_icons.bin
NEWCARDS_TABLES := build/assets/newcards__stats.bin build/assets/newcards__art_gfx.bin \
	build/assets/newcards__art_palettes.bin build/assets/newcards__id_to_number.bin \
	build/assets/newcards__names.bin build/assets/gfx__bank_a.bin
$(FIELD_ICONS): $(NEWCARDS_BUILT) $(NEWCARDS_TABLES) tools/cardicons.py tools/assets.py $(wildcard card_icons/*.png)
	$(PYTHON) tools/cardicons.py --data $@
# CARD_ID_COUNT (DATA_DECK_EDIT) must match field_icons.bin; both profiles share one checkout.
build/src/mod_field_icons.o: $(NEWCARDS_GEN) $(FIELD_ICONS)
build/data/mod_field_icons_data.o: $(NEWCARDS_GEN) $(FIELD_ICONS)

# The pre-duel pictures and their QR codes (tools/preduel_image.py; src/mod_preduel.c), for data/mod_preduel_data.s.
# One per format opponent with a picture: duelists/<name>.png (240x96, up to 224 colours) and duelists/<name>.svg
# (its formatlibrary.com QR code); the names match data/mod_preduel_data.s.
PREDUEL_NAMES := yugi-kaiba critter treasure imperial android
PREDUEL_BINS := $(PREDUEL_NAMES:%=build/assets/preduel_%.bin)
build/assets/preduel_%.bin: duelists/%.png duelists/%.svg tools/preduel_image.py tools/assets.py tools/assetfmt/gfx_scenes.py
	@mkdir -p $(@D)
	$(PYTHON) tools/preduel_image.py duelists/$*.png $@ duelists/$*.svg
build/data/mod_preduel_data.o: $(PREDUEL_BINS)

build/data/%.o: data/%.s $(ASSETS_BUILT) $(NEWCARDS_BUILT)
	@mkdir -p $(@D)
	$(AS) $(ASFLAGS) --MD build/data/$*.d -o $@ $<

# hand-written assembly sources (SDK stubs etc.)
build/srcasm/%.o: src/%.s
	@mkdir -p $(@D)
	$(AS) $(ASFLAGS) --MD build/srcasm/$*.d -o $@ $<

# C units go through cpp, agbcc and as. Functions not yet matched stay as INCLUDE_ASM(...).
build/src/%.o: src/%.c config/cflags.txt | $(CC1_INSTALLED) build/include/card_count.h $(MOD_CONFIG)
	@mkdir -p $(@D)
	$(CPP) $(CPPFLAGS) -MMD -MP -MF build/src/$*.d -MT $@ $< -o build/src/$*.i
	$(call unit_cc,$*) $(call unit_cflags,$*) build/src/$*.i -o build/src/$*.s
	printf '\t.text\n\t.align 2, 0\n' >> build/src/$*.s
	$(AS) $(ASFLAGS) --MD build/src/$*.asm.d -o $@ build/src/$*.s

# objdiff / decomp.dev progress report (no baserom needed).
#   target = each unit's original assembly, base = its C with INCLUDE_ASM functions left out
#   (-DOBJDIFF_BASE); both get absolute data references resolved (tools/objdiff_resolve.py).
OBJDIFF_UNITS := $(filter-out crt0 veneer,$(patsubst asm/%.s,%,$(wildcard asm/*.s)))
OBJDIFF_OBJS  := $(foreach u,$(OBJDIFF_UNITS),build/objdiff/target/$(u).o $(if $(wildcard src/$(u).c),build/objdiff/base/$(u).o))

objdiff.json: units.txt tools/mkobjdiff.py FORCE
	$(PYTHON) tools/mkobjdiff.py > $@

objdiff-report: objdiff.json $(OBJDIFF_OBJS) $(patsubst src/%.s,build/srcasm/%.o,$(wildcard src/*.s src/sdk/*.s)) build/src/sdk/agb_sram.o
	objdiff-cli report generate -p . -o build/report.json
	$(PYTHON) tools/mkobjdiff.py --summary build/report.json
	$(PYTHON) tools/check_report.py build/report.json

build/objdiff/raw/%.o: src/%.c config/cflags.txt | $(CC1_INSTALLED) build/include/card_count.h
	@mkdir -p $(@D)
	$(CPP) $(CPPFLAGS) -DOBJDIFF_BASE $< -o build/objdiff/raw/$*.i
	$(call unit_cc,$*) $(call unit_cflags,$*) build/objdiff/raw/$*.i -o build/objdiff/raw/$*.s
	printf '\t.text\n\t.align 2, 0\n' >> build/objdiff/raw/$*.s
	$(AS) $(ASFLAGS) -o $@ build/objdiff/raw/$*.s

build/objdiff/base/%.o: build/objdiff/raw/%.o tools/objdiff_resolve.py
	@mkdir -p $(@D)
	$(PYTHON) tools/objdiff_resolve.py $< $@

build/objdiff/target/%.o: build/asm/%.o tools/objdiff_resolve.py
	@mkdir -p $(@D)
	$(PYTHON) tools/objdiff_resolve.py $< $@

-include $(wildcard build/*/*.d build/*/*/*.d)

print-%:
	@echo '$*=$($*)'
